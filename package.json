{
  "name": "@objectid/digital-twin-integration-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings=0",
    "test": "vitest run tests",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:conformance": "vitest run tests/conformance",
    "test:coverage": "vitest run --coverage",
    "conformance-report": "vitest run tests/conformance --reporter=json --outputFile=reports/conformance-results.json && tsx scripts/generate-conformance-report.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@iota/iota-sdk": "1.10.1",
    "@objectid/oid-provider": "^1.10.17",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "canonicalize": "3.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mqtt": "^5.14.1",
    "node-opcua": "2.175.6",
    "pino": "^9.9.4",
    "prom-client": "^15.1.3",
    "redis": "^5.12.1",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.1",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.35.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "@iota/iota-sdk": "1.10.1"
  }
}
